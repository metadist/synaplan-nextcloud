{
  "name": "synaplan-nextcloud",
  "version": "1.8.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "lint": "eslint src/ tests/unit/ tests/e2e/ playwright.config.ts",
    "lint:fix": "eslint src/ tests/unit/ tests/e2e/ playwright.config.ts --fix",
    "format": "prettier --write src/ tests/unit/ tests/e2e/ playwright.config.ts vitest.config.ts",
    "format:check": "prettier --check src/ tests/unit/ tests/e2e/ playwright.config.ts vitest.config.ts",
    "check:types": "vue-tsc --noEmit && vue-tsc --noEmit -p tests/e2e",
    "test:unit": "vitest run",
    "test:e2e": "playwright test"
  },
  "prettier": "@nextcloud/prettier-config",
  "overrides": {
    "esbuild": "^0.28.1",
    "fast-xml-parser": "^5.7.0"
  },
  "dependencies": {
    "@mdi/svg": "^7.4.47",
    "@nextcloud/axios": "^2.5.1",
    "@nextcloud/dialogs": "^7.3.0",
    "@nextcloud/files": "^4.0.0",
    "@nextcloud/initial-state": "^3.0.0",
    "@nextcloud/l10n": "^3.1.0",
    "@nextcloud/router": "^3.0.1",
    "@nextcloud/vue": "^9.8.2",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@nextcloud/eslint-config": "8.4.2",
    "@nextcloud/prettier-config": "1.2.0",
    "@nextcloud/vite-config": "2.5.4",
    "@playwright/test": "1.64.1",
    "happy-dom": "21.0.4",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.13"
  }
}

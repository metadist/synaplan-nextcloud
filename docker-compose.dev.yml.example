# Local Nextcloud for Synaplan Integration development (WSL).
#
# Prerequisites: the Synaplan stack is up in ../synaplan with Keycloak
# (`docker compose --profile oidc up -d`), so the external network
# synaplan_synaplan-network and the realm's `nextcloud` client exist.
#
#   cp docker-compose.dev.yml.example docker-compose.dev.yml
#   make dev-up                                          # Nextcloud 35, the top of the supported range
#   NC_IMAGE=nextcloud:33-apache make dev-reset dev-up   # the floor; a major version change needs fresh volumes
#   NC_OIDC=0 make dev-reset dev-up                      # without organisation login
#
# UI: http://localhost:8081 — admin / admin; ada, bob, carol / <name>-dev-pass.
# From these containers Synaplan is http://backend and Keycloak http://keycloak:8080.
#
# The app is mounted at /mnt/synaplan_integration and linked into custom_apps
# by a hook. Do not bind-mount onto custom_apps/ directly — that makes
# /var/www/html look non-empty and the official image skips copying files.

x-nextcloud: &nextcloud
  image: ${NC_IMAGE:-nextcloud:35-apache@sha256:eee9c9f52a0d623082e8507186ea0c1ca1cf1e4a9075b99865c7f938110cb5d2}
  volumes:
    - nextcloud_data:/var/www/html
    - ./:/mnt/synaplan_integration
  networks:
    - default
    - synaplan-network
  restart: unless-stopped

services:
  nextcloud:
    <<: *nextcloud
    container_name: synaplan-nextcloud-dev
    hostname: nextcloud
    ports:
      - "8081:80"
    environment:
      MYSQL_HOST: nextcloud-db
      MYSQL_DATABASE: nextcloud
      MYSQL_USER: nextcloud
      MYSQL_PASSWORD: nextcloud
      NEXTCLOUD_ADMIN_USER: admin
      NEXTCLOUD_ADMIN_PASSWORD: admin
      # The login form only accepts a trusted Origin, and the browser sends it with the port.
      NEXTCLOUD_TRUSTED_DOMAINS: localhost localhost:8081 nextcloud 127.0.0.1 host.docker.internal
      OVERWRITEHOST: localhost:8081
      OVERWRITEPROTOCOL: http
      OVERWRITECLIURL: http://localhost:8081
      PHP_MEMORY_LIMIT: 1G
      NC_OIDC: ${NC_OIDC:-1}
    volumes:
      - nextcloud_data:/var/www/html
      - ./:/mnt/synaplan_integration
      - ./docker/dev-hooks/before-starting:/docker-entrypoint-hooks.d/before-starting:ro
      - ./docker/dev-hooks/post-installation:/docker-entrypoint-hooks.d/post-installation:ro
    depends_on:
      nextcloud-db:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "curl", "-fs", "http://localhost/status.php"]
      interval: 10s
      timeout: 5s
      retries: 30
      start_period: 180s

  # System cron: background jobs run every five minutes, as on a real server.
  nextcloud-cron:
    <<: *nextcloud
    container_name: synaplan-nextcloud-dev-cron
    entrypoint: /cron.sh
    depends_on:
      nextcloud:
        condition: service_healthy

  # Private network only: the Synaplan network already has a service called `db`.
  nextcloud-db:
    image: mariadb:11.8@sha256:c4124d1afa875e47f2892edf26b482fa54f796e2f342d3717a04ca091a22a9bd
    container_name: synaplan-nextcloud-dev-db
    command: --transaction-isolation=READ-COMMITTED
    environment:
      MARIADB_ROOT_PASSWORD: nextcloud-root
      MARIADB_DATABASE: nextcloud
      MARIADB_USER: nextcloud
      MARIADB_PASSWORD: nextcloud
    volumes:
      - nextcloud_db:/var/lib/mysql
    healthcheck:
      test: ["CMD", "healthcheck.sh", "--connect", "--innodb_initialized"]
      interval: 5s
      timeout: 5s
      retries: 30
    restart: unless-stopped

networks:
  synaplan-network:
    external: true
    name: synaplan_synaplan-network

volumes:
  nextcloud_data:
  nextcloud_db:
